NODE_ENV=development
LOG_LEVEL=info
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
NOTES_SERVICE_PORT=8082
AUDIT_SERVICE_PORT=8083
AUTH_SERVICE_URL=http://localhost:8081
NOTES_SERVICE_URL=http://localhost:8082
AUDIT_SERVICE_URL=http://localhost:8083
NATS_URL=nats://localhost:4222
AUTH_DATABASE_URL=postgres://auth:local-dev-only@localhost:5433/auth_db
NOTES_DATABASE_URL=postgres://notes:local-dev-only@localhost:5434/notes_db
AUDIT_DATABASE_URL=postgres://audit:local-dev-only@localhost:5435/audit_db
JWT_PRIVATE_KEY_FILE=../../keys/jwt-private.jwk.json
JWT_PUBLIC_KEY_FILE=../../keys/jwt-public.jwk.json
