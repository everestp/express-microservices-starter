{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@starter/contracts": "workspace:*",
    "@starter/http-kit": "workspace:*",
    "express": "^5.1.0",
    "@starter/service-client": "workspace:*",
    "@starter/service-auth": "workspace:*",
    "@starter/telemetry": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4"
  }
}
