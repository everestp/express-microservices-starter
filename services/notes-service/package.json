{
  "name": "notes-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "migrate": "node --env-file-if-exists=../../.env --import tsx ../../packages/database/src/cli.ts migrations up NOTES_DATABASE_URL",
    "migrate:down": "node --env-file-if-exists=../../.env --import tsx ../../packages/database/src/cli.ts migrations down NOTES_DATABASE_URL",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@starter/database": "workspace:*",
    "@starter/errors": "workspace:*",
    "@starter/http-kit": "workspace:*",
    "@starter/contracts": "workspace:*",
    "@starter/service-auth": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4"
  }
}
