{
  "name": "express-microservices-starter",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "changeset publish",
    "migrate:all": "pnpm --filter auth-service migrate && pnpm --filter notes-service migrate && pnpm --filter audit-service migrate",
    "keys:generate": "node scripts/gen-keys.mjs",
    "docker:up": "docker compose -f deploy/compose/docker-compose.yml up -d --wait",
    "docker:down": "docker compose -f deploy/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "@changesets/cli": "^3.0.3",
    "eslint": "^10.13.0",
    "@starter/eslint-config": "workspace:*",
    "turbo": "^2.5.3",
    "typescript": "^7.0.2"
  }
}
