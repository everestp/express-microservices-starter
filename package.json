{
  "name": "express-microservices-starter",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:architecture && pnpm test:contract",
    "test:unit": "turbo run test",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:integration": "pnpm test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "changeset publish",
    "openapi": "node scripts/export-openapi.mjs",
    "seed": "node scripts/seed.mjs",
    "migrate:all": "pnpm --filter auth-service migrate && pnpm --filter notes-service migrate && pnpm --filter audit-service migrate",
    "keys:generate": "node scripts/gen-keys.mjs",
    "docker:up": "docker compose -f deploy/compose/docker-compose.yml up -d --wait",
    "docker:down": "docker compose -f deploy/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "@starter/eslint-config": "workspace:*",
    "pg": "^8.16.0",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3"
  }
}
